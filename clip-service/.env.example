SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# FE Next.js API route와 공유하는 서버 간 인증 시크릿 (랜덤 문자열)
CLIP_INTERNAL_TOKEN=

# 분석 파라미터 (선택, 기본값 있음)
CLIP_SIMILARITY_THRESHOLD=0.92
CLIP_MODEL_NAME=ViT-B-32
CLIP_MODEL_PRETRAINED=openai
DOWNLOAD_CONCURRENCY=12
EMBEDDING_BATCH_SIZE=16
MAX_CONCURRENT_PROJECTS=1

# ── Gemini Embedding POC (OpenCLIP과 완전히 독립, 서버 전용) ──
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=3072
GEMINI_SIMILARITY_THRESHOLD=0.96
GEMINI_CONCURRENCY=4
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=30
GEMINI_IMAGE_PRICE_USD=0.00012

# ── 보정본↔원본 매칭 (Gemini 임베딩, matcher.py의 OpenCLIP AUTO/LOW 대체) ──
GEMINI_MATCH_AUTO_THRESHOLD=0.96
GEMINI_MATCH_LOW_THRESHOLD=0.85

# ── Gemini Flash 품질 판정 POC (Embedding과도 완전히 독립, GEMINI_API_KEY 공유) ──
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_QUALITY_PROMPT_VERSION=v1
GEMINI_QUALITY_CONCURRENCY=4
GEMINI_QUALITY_MAX_RETRIES=2
GEMINI_QUALITY_TIMEOUT_SECONDS=30
GEMINI_FLASH_INPUT_PRICE_PER_1M=0.30
GEMINI_FLASH_OUTPUT_PRICE_PER_1M=2.50
