# Supabase (프론트와 동일 프로젝트)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# R2 (Cloudflare R2 - 보정본/사진 업로드). Cloudflare 대시보드에서 값 확인 후 입력
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 내부 presign API 인증 (Next.js 서버 → FastAPI 전용). 프론트 INTERNAL_PRESIGN_SECRET과 동일한 값이어야 함
INTERNAL_PRESIGN_SECRET=

# 원본 아카이브 ZIP 파트 최대 크기(bytes)
ARCHIVE_PART_MAX_BYTES=

# CORS 허용 origin (콤마 구분)
ALLOWED_ORIGINS=http://localhost:3000
